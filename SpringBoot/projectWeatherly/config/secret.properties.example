# 🔐 비밀 설정 파일 템플릿
# 이 파일을 복사하여 secret.properties로 만들고 실제 값을 입력하세요

# ====================
# 데이터베이스 설정
# ====================
spring.datasource.password=YOUR_DATABASE_PASSWORD_HERE

# ====================
# API 키 설정
# ====================
# 기상청 API 키 (공공데이터포털)
api.kma.key=YOUR_KMA_API_KEY_HERE

# 에어코리아 API 키 (공공데이터포털)
api.airkorea.key=YOUR_AIRKOREA_API_KEY_HERE

# 카카오 API 키 (카카오 개발자센터 - 주소 변환용)
api.kakao.key=YOUR_KAKAO_API_KEY_HERE

# ====================
# Redis 설정
# ====================
spring.redis.password=YOUR_REDIS_PASSWORD_HERE

# ====================
# 이메일 설정
# ====================
spring.mail.username=YOUR_EMAIL_ADDRESS_HERE
spring.mail.password=YOUR_EMAIL_PASSWORD_HERE

# ====================
# JWT 설정
# ====================
app.jwt.secret=YOUR_JWT_SECRET_KEY_MIN_256BIT_HERE
app.jwt.expiration=86400000